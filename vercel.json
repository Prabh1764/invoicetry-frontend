{
  "version": 2,
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo 'Flutter will be installed in build script'",
  "rewrites": [
    {
      "source": "/((?!.*\\.(js|css|wasm|json|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|html)).*)",
      "destination": "/index.html"
    }
  ]
}
